# Cross-compile image for win64 builds from Linux, matching the toolchain that
# .github/workflows/build.yml uses. Debian and Ubuntu ship no MinGW Qt6
# packages, so the build has to happen on Fedora.
#
#   podman build -t w32di-build -f tools/Containerfile.build
#
# See BUILD.md, "Cross-compiling ... in a container".
FROM fedora:44

RUN dnf -y install \
        cmake ninja-build file findutils binutils \
        mingw64-gcc-c++ mingw64-qt6-qtbase mingw64-qt6-qttools \
        mingw64-qt6-qttranslations \
        mingw64-zlib mingw64-xz \
        qt6-linguist \
    && dnf clean all

# Fail early and loudly if the layout is not what the build expects.
RUN test -f /usr/share/mingw/toolchain-mingw64.cmake && test -x /usr/bin/lrelease-qt6

WORKDIR /src
